# ---------------------------------------------------------------------------
# Invertir con Valores — environment variables
# Copy to .env.local for local development. Every variable is optional:
# empty values hide the related link or switch to a graceful fallback.
# ---------------------------------------------------------------------------

# Canonical origin (no trailing slash). Used for canonical URLs, sitemap, OG, RSS.
NEXT_PUBLIC_SITE_URL=https://www.invertirconvalores.com

# --- Community & booking ----------------------------------------------------
# Telegram group invite link. Empty = CTAs point to the newsletter/guide form.
NEXT_PUBLIC_TELEGRAM_URL=
# Cal.com booking page, e.g. https://cal.com/stefano/cafe-financiero. Empty = "coming soon" fallback.
NEXT_PUBLIC_CAL_URL=
# Substack publication. Used as newsletter fallback when no lead provider is configured.
NEXT_PUBLIC_SUBSTACK_URL=

# --- Social profiles (footer icons; empty = hidden) -------------------------
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Public contact email (Reply-To of confirmation emails).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Lead storage (guide, newsletter, waitlist) -----------------------------
# Leads are accepted if at least ONE provider below is configured.
# In `pnpm dev` with none configured, leads are only logged to the console.

# 1) Postgres (Drizzle). Run `pnpm db:push` once to create the `leads` table.
#    Use a pooled connection string on serverless (Supabase/Neon pooler).
DATABASE_URL=

# 2) Mailgun: confirmation emails (+ optional mailing list as newsletter audience).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.invertirconvalores.com
# EU region recommended for Spain. Leave empty for the US region.
MAILGUN_API_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL="Stefano · Invertir con Valores <hola@invertirconvalores.com>"
# Mailing list address used as the newsletter provider (e.g. newsletter@mg.invertirconvalores.com).
MAILGUN_LIST_ADDRESS=
# 3) Get every new lead in your inbox (needs Mailgun).
LEADS_NOTIFY_EMAIL=
# Inbound webhook (/api/mailgun) that forwards replies. Optional.
MAILGUN_SIGNING_KEY=
MAILGUN_FORWARD_REPLIES_TO=

# Link to the free guide (PDF/Notion) sent in the confirmation email.
# Empty = the email says the guide is on its way.
GUIDE_URL=

# --- Analytics (loaded only after cookie consent) ---------------------------
# Plausible site domain. Empty = no analytics and no cookie banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted Plausible script URL.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
